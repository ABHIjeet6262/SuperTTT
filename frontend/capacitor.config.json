{
  "appId": "com.superttt.app",
  "appName": "SuperTTT",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "backgroundColor": "#0b0e14",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b0e14",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
